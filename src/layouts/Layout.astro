---
import { aboveTheFoldFontPreloads } from "../styles/fonts";
import { getSite, type SiteContent } from "../lib/content";
import {
  defaultLocale,
  htmlLang,
  ogLocale,
  resolveLocale,
  type Locale,
} from "../locales";
import { absoluteLocaleUrl, stripLocalePrefix } from "../lib/i18n/paths";
import { PREFERRED_LOCALE_COOKIE } from "../lib/i18n/locale";

interface Props {
  robots?: string;
  title?: string;
  description?: string;
  ogImageAlt?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  locale?: Locale;
  site?: SiteContent;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const siteContent = Astro.props.site ?? (await getSite(locale));

const barePath = stripLocalePrefix(Astro.url.pathname);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const ptAlternate = absoluteLocaleUrl("pt", barePath);
const enAlternate = absoluteLocaleUrl("en", barePath);
const xDefault = absoluteLocaleUrl(defaultLocale, barePath);

const {
  robots = "index, follow",
  title = siteContent.seo.title,
  description = siteContent.seo.description,
  ogImageAlt = siteContent.seo.ogImageAlt,
  ogImage = locale === "en" ? "/og-image-en.png" : "/og-image.png",
  jsonLd = {},
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site);
const schema = JSON.stringify(jsonLd);
const localeRedirectOnRoot = Astro.url.pathname === "/";
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      localeRedirectOnRoot ? (
        <script is:inline define:vars={{ cookieName: PREFERRED_LOCALE_COOKIE }}>
          (function () {
            var BOT_UA =
              /googlebot|bingbot|yandex|baiduspider|duckduckbot|slurp|facebookexternalhit|twitterbot|linkedinbot|embedly|quora link preview|showyoubot|outbrain|pinterest|applebot|semrushbot|ahrefsbot|rogerbot|screaming frog|ia_archiver/i;
            if (BOT_UA.test(navigator.userAgent)) return;

            function readCookie(name) {
              var parts = document.cookie.split(";");
              for (var i = 0; i < parts.length; i++) {
                var part = parts[i].trim();
                var eq = part.indexOf("=");
                if (eq === -1) continue;
                if (part.slice(0, eq) === name) {
                  return decodeURIComponent(part.slice(eq + 1));
                }
              }
              return "";
            }

            var preferred = readCookie(cookieName);
            if (preferred === "pt") return;
            if (preferred === "en") {
              location.replace("/en/");
              return;
            }

            var lang = (navigator.language || "").toLowerCase();
            if (lang.indexOf("pt") === 0) return;
            location.replace("/en/");
          })();
        </script>
      ) : null
    }
    {
      aboveTheFoldFontPreloads.map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      ))
    }
    <script is:inline defer type="application/ld+json" set:html={schema} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pt" href={ptAlternate} />
    <link rel="alternate" hreflang="en" href={enAlternate} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta name="robots" content={robots} />
    <meta name="author" content={siteContent.person.fullName} />
    <meta name="apple-mobile-web-app-title" content="André Portfolio" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={siteContent.seo.title} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta
      property="og:locale:alternate"
      content={locale === "pt" ? ogLocale("en") : ogLocale("pt")}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body class="min-h-screen overflow-x-clip pt-0">
    <slot />
  </body>
</html>
