---
interface Props {
  id: string;
  name: string;
  type?: astroHTML.JSX.HTMLInputTypeAttribute;
  label: string;
  placeholder?: string;
  required?: boolean;
  rows?: number;
  inverted?: boolean;
}

const {
  id,
  name,
  type: typeProp,
  label,
  placeholder,
  required = false,
  rows,
  inverted = false,
} = Astro.props;

const inputType: astroHTML.JSX.HTMLInputTypeAttribute = typeProp ?? "text";

const baseField = inverted
  ? "w-full rounded-input border border-hero-foreground/30 bg-transparent px-4 text-base leading-normal text-hero-foreground placeholder:text-hero-foreground/50 transition-colors duration-200 outline-none hover:border-hero-foreground/60 focus:border-accent disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-danger"
  : "w-full rounded-input border border-border bg-input px-4 text-base leading-normal text-foreground placeholder:text-muted-foreground transition-colors duration-200 outline-none hover:border-border-hover focus:border-accent disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-danger";

const sizeField = rows
  ? "min-h-30 resize-y py-3 md:min-h-35"
  : "h-12 md:h-14";

const labelClass = inverted
  ? "text-sm font-semibold text-hero-foreground/80"
  : "text-sm font-semibold text-foreground";
---

<div class="flex flex-col gap-2">
  <label for={id} class:list={[labelClass]}>
    {label}
  </label>
  {
    rows ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        placeholder={placeholder}
        required={required}
        class:list={[baseField, sizeField, "focus-ring"]}
      />
    ) : (
      <input
        id={id}
        name={name}
        type={inputType}
        placeholder={placeholder}
        required={required}
        class:list={[baseField, sizeField, "focus-ring"]}
      />
    )
  }
</div>
