---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import type { ProjectEntry } from "../../lib/content";
import { projectImageAlt } from "../../lib/project-page";
import { getDominantColor } from "../../lib/dominant-color";

interface Props {
  project: ProjectEntry;
  href: string;
  ctaLabel: string;
  stackAria: string;
  imageAltTemplate: string;
  featured?: boolean;
  eager?: boolean;
}

const {
  project,
  href,
  ctaLabel,
  stackAria,
  imageAltTemplate,
  featured = false,
  eager = false,
} = Astro.props;

const landscape = project.data.imageUrl;
const featuredPortrait = featured ? (project.data.featuredImageUrl ?? null) : null;
const imageAlt = projectImageAlt(project, imageAltTemplate);
const landscapeColor = await getDominantColor(landscape);
const portraitColor = featuredPortrait
  ? await getDominantColor(featuredPortrait)
  : landscapeColor;
---

<article
  class:list={[
    "card-hover-bordered group/card min-w-0 w-full max-w-full overflow-hidden",
    featuredPortrait
      ? "grid grid-cols-1 lg:grid-cols-[16rem_1fr]"
      : "flex h-full min-h-0 flex-col",
  ]}
>
  <a
    href={href}
    class:list={[
      "relative block min-w-0 overflow-hidden border-b border-border",
      featuredPortrait
        ? "aspect-video lg:aspect-auto lg:flex lg:min-h-80 lg:items-stretch lg:justify-center lg:border-b-0 lg:border-r"
        : "aspect-video",
    ]}
  >
    <div
      class:list={["h-full w-full", featuredPortrait && "lg:hidden"]}
      style={`background-color: ${landscapeColor}`}
    >
      <Image
        src={landscape}
        alt={imageAlt}
        width={landscape.width}
        height={landscape.height}
        sizes={
          featuredPortrait
            ? "(max-width: 1023px) 100vw, 0px"
            : "(max-width: 1024px) 100vw, 40vw"
        }
        class="h-full w-full object-contain"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </div>
    {
      featuredPortrait && (
        <div
          class="hidden h-full w-full lg:block"
          style={`background-color: ${portraitColor}`}
        >
          <Image
            src={featuredPortrait}
            alt={imageAlt}
            width={featuredPortrait.width}
            height={featuredPortrait.height}
            sizes="16rem"
            class="h-full max-h-full w-full object-contain"
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      )
    }
  </a>
  <div class="flex min-w-0 flex-1 flex-col p-6 md:p-8">
    <h3 class="card-hover-title font-display min-w-0 wrap-break-word text-xl font-extrabold text-foreground">
      <a href={href} class="inline wrap-break-word focus-ring">
        {project.data.title}
      </a>
    </h3>
    <p class="mt-4 flex-1 text-sm leading-relaxed text-foreground-variant md:text-base">
      {project.data.shortDescription}
    </p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label={stackAria}>
      {
        project.data.tech.map((tech) => (
          <li class="rounded-pill bg-muted px-2.5 py-1 text-xs font-semibold text-foreground">
            {tech}
          </li>
        ))
      }
    </ul>
    <div class="mt-6">
      <Button href={href} variant="secondary" showArrow class="w-full justify-center">
        {ctaLabel}
      </Button>
    </div>
  </div>
</article>
