---
import Container from "../ui/Container.astro";
import AccentBar from "../ui/AccentBar.astro";
import Reveal from "../ui/Reveal.astro";
import Button from "../ui/Button.astro";
import ProjectTile from "../ui/ProjectTile.astro";
import type { ProjectEntry } from "../../lib/content";
import { getProjectPagePath, getProjectsIndexPath } from "../../lib/project-page";
import { getPageContext } from "../../lib/i18n/context";

interface Props {
  projects: ProjectEntry[];
}

const { locale, ui, site } = await getPageContext(Astro.currentLocale);
const { projects: projectEntries } = Astro.props;

const PROJECTS_HOME_GRID = 2;
const featuredProject = projectEntries[0] ?? null;
const gridProjects = projectEntries.slice(1, 1 + PROJECTS_HOME_GRID);
const projectsIndexHref = getProjectsIndexPath(locale);
---

<section
  id="projetos"
  class="scroll-mt-20 bg-muted py-16 md:py-20 lg:py-24"
  aria-labelledby="projects-heading"
>
  <Container>
    <div class="grid min-w-0 grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <Reveal staggerMs={0} class="min-w-0 lg:col-span-5">
        <AccentBar class="mb-6" />
        <h2
          id="projects-heading"
          class="font-display text-3xl font-extrabold leading-tight tracking-tight text-foreground sm:text-4xl md:text-5xl"
        >
          {ui.projects.title}
        </h2>
        <p class="mt-4 text-sm font-semibold text-muted-foreground">
          {ui.projects.subtitle}
        </p>
      </Reveal>
      <Reveal staggerMs={80} class="flex min-w-0 items-center lg:col-span-7">
        <p class="text-base leading-[1.7] text-foreground-variant">
          {site.sections.projectsSubtitle}{" "}
          <a
            href={site.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-accent underline decoration-accent/40 decoration-1 underline-offset-4 transition-colors duration-200 hover:decoration-accent focus-ring"
          >
            {ui.projects.githubCta}
          </a>
        </p>
      </Reveal>
    </div>

    {
      featuredProject && (
        <div class="mt-14 lg:mt-16">
          <Reveal staggerMs={0}>
            <ProjectTile
              project={featuredProject}
              href={getProjectPagePath(featuredProject.slug, locale)}
              ctaLabel={ui.projects.viewDetails}
              stackAria={ui.projects.stackAria}
              imageAltTemplate={ui.projectPage.imageAlt}
              featured
              eager
            />
          </Reveal>
        </div>
      )
    }

    <ul
      class:list={[
        "list-none grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8",
        featuredProject ? "mt-8" : "mt-14 lg:mt-16",
      ]}
    >
      {
        gridProjects.map((project, index) => (
          <li class="min-h-0 h-full">
            <Reveal staggerMs={index * 60} class="h-full min-h-0">
              <ProjectTile
                project={project}
                href={getProjectPagePath(project.slug, locale)}
                ctaLabel={ui.projects.viewDetails}
                stackAria={ui.projects.stackAria}
                imageAltTemplate={ui.projectPage.imageAlt}
              />
            </Reveal>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex justify-center">
      <Button href={projectsIndexHref} variant="secondary" showArrow>
        {ui.projects.viewAll}
      </Button>
    </div>
  </Container>
</section>
