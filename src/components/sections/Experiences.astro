---
import Container from "../ui/Container.astro";
import AccentBar from "../ui/AccentBar.astro";
import Reveal from "../ui/Reveal.astro";
import { Image } from "astro:assets";
import type { ExperienceList } from "../../lib/content";
import { getPageContext } from "../../lib/i18n/context";

interface Props {
  experiences: ExperienceList;
}

const { ui, site } = await getPageContext(Astro.currentLocale);
const { experiences } = Astro.props;
---

<section
  id="experiencias"
  class="scroll-mt-20 bg-background py-16 md:py-20 lg:py-24"
  aria-labelledby="exp-heading"
>
  <Container>
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <Reveal staggerMs={0} class="lg:col-span-5">
        <AccentBar class="mb-6" />
        <h2
          id="exp-heading"
          class="font-display text-3xl font-extrabold leading-tight tracking-tight text-foreground sm:text-4xl md:text-5xl"
        >
          {ui.experiences.title}
        </h2>
        <p class="mt-4 text-sm font-semibold text-muted-foreground">
          {ui.experiences.subtitle}
        </p>
      </Reveal>
      <Reveal staggerMs={80} class="flex items-center lg:col-span-7">
        <p class="text-base leading-[1.7] text-foreground-variant">
          {site.sections.experiencesIntro}
        </p>
      </Reveal>
    </div>

    <ul class="mt-14 list-none space-y-5 lg:mt-16">
      {
        experiences.map((exp, index) => (
          <li>
            <Reveal staggerMs={index * 60}>
              <article class="bg-muted card-hover-bordered group/card grid grid-cols-1 gap-6 overflow-hidden p-6 md:p-8 lg:grid-cols-12 lg:gap-8">
                <div
                  class="h-2 w-full rounded-pill lg:hidden bg-accent"
                ></div>
                <header class="flex gap-4 lg:col-span-4">
                  <span
                    class="hidden w-2 shrink-0 rounded-pill lg:block bg-accent"
                    aria-hidden="true"
                  ></span>
                  <div class="min-w-0">
                    <h3 class="card-hover-title font-display text-xl font-extrabold leading-tight text-foreground md:text-2xl">
                      {exp.role}
                    </h3>
                    <div class="mt-1 flex min-w-0 items-center gap-1.5 text-base font-semibold text-accent">
                      {exp.logo && (
                        <Image
                          src={exp.logo}
                          alt={`Logo ${exp.company}`}
                          width={24}
                          height={24}
                          sizes="20px"
                          class="size-[1.15em] shrink-0 object-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <p>{exp.company}</p>
                    </div>
                    <p class="mt-2 text-xs font-semibold text-muted-foreground">
                      {exp.period}
                    </p>
                  </div>
                </header>

                <div class="min-w-0 lg:col-span-8">
                  <p class="text-base leading-[1.7] text-foreground-variant">
                    {exp.summary}
                  </p>
                  {exp.highlights && exp.highlights.length > 0 && (
                    <ul
                      class="mt-6 list-disc space-y-3 pl-5 text-sm leading-relaxed text-foreground-variant md:text-base"
                      aria-label={ui.experiences.highlightsAria.replace(
                        "{company}",
                        exp.company,
                      )}
                    >
                      {exp.highlights.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
