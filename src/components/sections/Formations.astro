---
import Container from "../ui/Container.astro";
import AccentBar from "../ui/AccentBar.astro";
import Reveal from "../ui/Reveal.astro";
import { Image } from "astro:assets";
import type { FormationList } from "../../lib/content";
import { getPageContext } from "../../lib/i18n/context";

interface Props {
  formations: FormationList;
}

const { ui } = await getPageContext(Astro.currentLocale);
const { formations } = Astro.props;

const formationItems = formations.map((formation, index) => ({
  formation,
  index,
}));
const showFormationsFooter = formations.some((f) => !f.featured);
---

<section
  id="formacoes"
  class="scroll-mt-20 bg-muted py-16 md:py-20 lg:py-24"
  aria-labelledby="form-heading"
>
  <Container>
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <Reveal staggerMs={0} class="lg:col-span-5">
        <AccentBar class="mb-6" />
        <h2
          id="form-heading"
          class="font-display text-3xl font-extrabold leading-tight tracking-tight text-foreground sm:text-4xl md:text-5xl"
        >
          {ui.formations.title}
        </h2>
        <p class="mt-4 text-sm font-semibold text-muted-foreground">
          {ui.formations.subtitle}
        </p>
      </Reveal>
      <Reveal staggerMs={80} class="flex items-center lg:col-span-7">
        <p class="text-base leading-[1.7] text-foreground-variant">
          {ui.formations.intro}
        </p>
      </Reveal>
    </div>

    <div
      data-expandable-list
      data-scroll-section="formacoes"
      data-expand-label={ui.formations.expandLess}
      data-collapse-label={ui.formations.expandMore}
    >
      <ul class="mt-14 list-none space-y-4 lg:mt-16">
        {
          formationItems.map(({ formation, index }) => {
            const isExtra = !formation.featured;
            const { title, institution, period, logo, description, link } =
              formation;

            return (
              <li
                class:list={[isExtra && "hidden"]}
                data-expandable-extra={isExtra ? "" : undefined}
              >
                <Reveal staggerMs={index * 60}>
                  <article class="card-hover-bordered group/card grid grid-cols-1 gap-6 p-6 md:p-8 lg:grid-cols-[auto_1fr] lg:gap-8">
                    <div
                      class="flex size-16 shrink-0 items-center justify-center rounded-card border border-border bg-white lg:size-20"
                    >
                      <Image
                        src={logo}
                        alt={`Logo ${institution}`}
                        format="webp"
                        width={80}
                        height={80}
                        sizes="80px"
                        class="max-h-12 max-w-12 object-contain p-2 lg:max-h-14 lg:max-w-14"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="min-w-0">
                      <h3 class="card-hover-title font-display text-xl font-extrabold leading-tight text-foreground">
                        {title}
                      </h3>
                      <div class="mt-2 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                        <span class="text-sm font-semibold text-foreground-variant">
                          {institution}
                        </span>
                        <span class="text-xs font-semibold text-muted-foreground">
                          {period}
                        </span>
                      </div>
                      {description && (
                        <p class="mt-4 max-w-2xl text-base leading-[1.7] text-foreground-variant">
                          {description}
                        </p>
                      )}
                      {link && (
                        <p class="mt-5">
                          <a
                            href={link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-semibold text-accent underline decoration-accent/40 decoration-1 underline-offset-4 transition-colors duration-200 hover:decoration-accent focus-ring"
                          >
                            {ui.formations.credentialCta}
                          </a>
                        </p>
                      )}
                    </div>
                  </article>
                </Reveal>
              </li>
            );
          })
        }
      </ul>

      {
        showFormationsFooter && (
          <div class="mt-10 flex flex-col items-center justify-center gap-4">
            <button
              type="button"
              class="inline-flex min-h-11 items-center justify-center rounded-pill border border-foreground px-5 py-3 text-sm font-semibold text-foreground transition-colors duration-200 hover:bg-foreground hover:text-background focus-ring active:translate-y-px"
              data-expandable-show-more
              aria-expanded="false"
            >
              {ui.formations.expandMore}
            </button>
          </div>
        )
      }
    </div>
  </Container>
</section>
