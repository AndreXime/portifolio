---
import HeroBody from "./HeroBody.astro";
import { getPageContext } from "../../lib/i18n/context";

const { locale, ui, site } = await getPageContext(Astro.currentLocale);
---

<section
  id="inicio"
  class="relative min-h-dvh overflow-hidden bg-hero text-hero-foreground scroll-mt-0"
  aria-labelledby="hero-heading"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(160deg,var(--color-hero)_0%,var(--color-hero-2)_100%)]"
    aria-hidden="true"
  ></div>
  <div class="relative flex min-h-dvh w-full flex-col justify-center pt-28 pb-16 md:pt-36 md:pb-20 lg:pt-40 lg:pb-24">
    <HeroBody locale={locale} ui={ui} site={site} />
  </div>
</section>
