---
import { Icon } from "astro-icon/components";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { getPageContext } from "../../lib/i18n/context";
import { homeHash } from "../../lib/i18n/paths";

const { locale, ui, site } = await getPageContext(Astro.currentLocale);
const { hero } = site;
const headlineParts = hero.headline.split(hero.headlineAccent);
---

<section
  id="inicio"
  class="relative min-h-dvh overflow-hidden bg-hero text-hero-foreground scroll-mt-0"
  aria-labelledby="hero-heading"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(160deg,var(--color-hero)_0%,var(--color-hero-2)_100%)]"
    aria-hidden="true"
  ></div>
  <div class="relative flex min-h-dvh w-full flex-col justify-center pt-28 pb-16 md:pt-36 md:pb-20 lg:pt-40 lg:pb-24">
    <Container>
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,1fr)_30%] lg:gap-12">
        <div class="min-w-0">
          <p class="text-sm font-semibold text-hero-foreground/70">
            {site.authorName} · {site.person.jobTitle}
          </p>
          <h1
            id="hero-heading"
            class="font-display mt-5 max-w-[18ch] text-4xl font-extrabold leading-[1.08] tracking-tight text-hero-foreground sm:text-5xl md:text-6xl lg:text-[4.25rem]"
          >
            {headlineParts[0]}
            <span class="rounded-md bg-accent px-1.5 text-accent-foreground">
              {hero.headlineAccent}
            </span>
            {headlineParts[1]}
          </h1>
          <p class="mt-8 max-w-2xl text-base leading-[1.75] text-hero-foreground/85">
            {hero.intro}
          </p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <Button href={homeHash(locale, "projetos")} variant="primary" showArrow>
              {ui.hero.viewProjects}
            </Button>
            <Button href={homeHash(locale, "contato")} variant="secondary" onLight>
              {ui.hero.contactCta}
            </Button>
            <div class="flex items-center gap-3">
              <a
                href={site.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-11 shrink-0 items-center justify-center rounded-pill border border-hero-foreground/40 text-hero-foreground transition-colors duration-200 hover:bg-hero-foreground hover:text-hero focus-ring"
                aria-label="GitHub"
              >
                <Icon name="simple-icons:github" class="size-5" />
              </a>
              <a
                href={site.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-11 shrink-0 items-center justify-center rounded-pill border border-hero-foreground/40 text-hero-foreground transition-colors duration-200 hover:bg-hero-foreground hover:text-hero focus-ring"
                aria-label="LinkedIn"
              >
                <Icon name="simple-icons:linkedin" class="size-5" />
              </a>
            </div>
          </div>
        </div>

        <dl
          class="grid min-w-0 grid-cols-1 gap-3"
          aria-label={ui.hero.summaryAria}
        >
          <div class="hero-stat-card bg-hero-foreground/10 hover:bg-hero-foreground/18">
            <dt class="text-xs font-semibold text-hero-foreground/70">{ui.hero.stack}</dt>
            <dd class="mt-1 text-sm font-semibold text-hero-foreground">{hero.stackLine}</dd>
          </div>
          <div class="hero-stat-card bg-accent text-accent-foreground hover:bg-accent-hover">
            <dt class="text-xs font-semibold text-accent-foreground/80">{hero.availabilityLabel}</dt>
            <dd class="mt-1 text-sm font-semibold">{hero.availabilityValue}</dd>
          </div>
          <div class="hero-stat-card bg-hero-foreground/10 hover:bg-hero-foreground/18">
            <dt class="text-xs font-semibold text-hero-foreground/70">{ui.hero.location}</dt>
            <dd class="mt-1 text-sm font-semibold text-hero-foreground">{hero.locationValue}</dd>
          </div>
        </dl>
      </div>
    </Container>
  </div>
</section>
