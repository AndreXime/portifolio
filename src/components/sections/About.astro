---
import Container from "../ui/Container.astro";
import AccentBar from "../ui/AccentBar.astro";
import Reveal from "../ui/Reveal.astro";
import { getPageContext } from "../../lib/i18n/context";

const { ui, site } = await getPageContext(Astro.currentLocale);
---

<section
  id="sobre"
  class="scroll-mt-20 bg-muted py-16 md:py-20 lg:py-24"
  aria-labelledby="about-heading"
>
  <Container>
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <Reveal staggerMs={0} class="lg:col-span-4">
        <AccentBar class="mb-6" />
        <h2
          id="about-heading"
          class="font-display text-3xl font-extrabold leading-tight tracking-tight text-foreground sm:text-4xl md:text-5xl"
        >
          {ui.about.title}
        </h2>
        <p class="mt-4 text-sm font-semibold text-muted-foreground">
          {ui.about.subtitle}
        </p>
      </Reveal>

      <Reveal staggerMs={80} class="flex min-w-0 items-center lg:col-span-8">
        <blockquote class="font-display min-w-0 text-xl font-extrabold leading-[1.5] text-foreground">
          &ldquo;
          {site.about.quote.split(/==(.*?)==/g).map((segment, index) =>
            index % 2 === 1 ? (
              <mark class="highlight-quote">{segment}</mark>
            ) : (
              segment
            ),
          )}
          &rdquo;
        </blockquote>
      </Reveal>
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-10 pt-4 lg:grid-cols-12 lg:gap-12"
    >
      <Reveal staggerMs={100} class="lg:col-span-4">
        <figure class="mx-auto w-full max-w-72 overflow-hidden rounded-card bg-accent p-1 sm:max-w-80 lg:mx-0 lg:max-w-none">
          <img
            src="/me.webp"
            alt={site.about.photoAlt}
            width={424}
            height={424}
            class="aspect-square w-full rounded-[calc(var(--radius-card)-0.35rem)] object-cover object-center"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </Reveal>

      <Reveal staggerMs={140} class="lg:col-span-8">
        <div class="space-y-6 text-base leading-[1.7]">
          {
            site.about.paragraphs.map((paragraph, index) => (
              <p
                class:list={[
                  index === 0 ? "text-foreground" : "text-foreground-variant",
                ]}
                set:html={paragraph}
              />
            ))
          }
        </div>
      </Reveal>
    </div>
  </Container>
</section>
