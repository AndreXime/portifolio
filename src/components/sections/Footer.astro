---
import { Icon } from "astro-icon/components";
import Container from "../ui/Container.astro";
import { getPageContext } from "../../lib/i18n/context";
import { homeHash } from "../../lib/i18n/paths";

const { locale, ui, site } = await getPageContext(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-hero py-10 text-hero-foreground md:py-12">
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,var(--color-hero)_0%,var(--color-hero-2)_100%)]"
    aria-hidden="true"
  ></div>
  <Container class="relative">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="text-sm font-semibold text-hero-foreground/70">
          {ui.footer.portfolioPrefix} {site.authorName}
        </p>
        <p class="font-display mt-2 text-xl font-extrabold text-hero-foreground">
          {site.person.jobTitle}
        </p>
        <p class="mt-2 text-sm text-hero-foreground/70">
          &copy; {year}. {ui.footer.tagline}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-6 lg:col-span-5 lg:justify-end">
        <a
          href={site.blogUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-hero-foreground/70 transition-colors duration-200 hover:text-accent focus-ring"
          aria-label="Blog"
        >
          <Icon name="blog" class="h-5.75 w-auto" />
        </a>
        <a
          href={site.githubUrl}
          target="_blank"
          rel="me noopener noreferrer"
          class="text-hero-foreground/70 transition-colors duration-200 hover:text-accent focus-ring"
          aria-label="GitHub"
        >
          <Icon name="simple-icons:github" class="size-5.75" />
        </a>
        <a
          href={site.linkedinUrl}
          target="_blank"
          rel="me noopener noreferrer"
          class="text-hero-foreground/70 transition-colors duration-200 hover:text-accent focus-ring"
          aria-label="LinkedIn"
        >
          <Icon name="simple-icons:linkedin" class="size-5.75" />
        </a>
        <a
          href={homeHash(locale, "inicio")}
          class="cursor-pointer text-sm font-semibold text-hero-foreground/70 underline decoration-hero-foreground/30 underline-offset-4 transition-colors duration-200 hover:text-accent hover:decoration-accent focus-ring"
        >
          {ui.footer.backToTop}
        </a>
      </div>
    </div>
  </Container>
</footer>
