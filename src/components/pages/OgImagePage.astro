---
import "../../styles/fonts";
import "../../styles/global.css";
import Container from "../ui/Container.astro";
import { getPageContext } from "../../lib/i18n/context";
import { htmlLang } from "../../locales";

const { locale, ui, site } = await getPageContext(Astro.currentLocale);
const { hero, ogImage } = site;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <style is:inline>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        box-sizing: border-box;
      }
    </style>
  </head>
  <body class="bg-hero text-hero-foreground antialiased">
    <section class="h-full bg-[linear-gradient(160deg,var(--color-hero)_0%,var(--color-hero-2)_100%)]">
      <Container class="flex h-full flex-col justify-between py-8">
        <div>
          <p class="text-2xl font-semibold text-accent">
            {ogImage.eyebrow}
          </p>
          <h1
            class="font-display mt-4 text-8xl font-extrabold leading-[1.05] tracking-tight text-hero-foreground"
          >
            {site.authorName}
          </h1>
          <h2
            class="font-display mt-2 text-6xl font-extrabold leading-[1.1] tracking-tight text-hero-foreground"
          >
            {ogImage.titlePrefix}{" "}
            <span class="rounded-md bg-accent px-2 text-accent-foreground">
              {ogImage.titleAccent}
            </span>
          </h2>

          <p class="mt-6 max-w-4xl text-lg leading-normal text-hero-foreground/85">
            {ogImage.description}
          </p>
        </div>

        <dl class="grid grid-cols-4 gap-6 pt-6 text-base">
          <div class="rounded-card bg-hero-foreground/10 p-4">
            <dt class="text-sm font-semibold text-hero-foreground/70">
              {ui.hero.stack}
            </dt>
            <dd class="mt-2 font-semibold text-hero-foreground">
              {hero.stackLine}
            </dd>
          </div>
          <div class="rounded-card bg-accent p-4 text-accent-foreground">
            <dt class="text-sm font-semibold text-accent-foreground/80">
              {hero.availabilityLabel}
            </dt>
            <dd class="mt-2 font-semibold">
              {hero.availabilityValue}
            </dd>
          </div>
          <div class="rounded-card bg-hero-foreground/10 p-4">
            <dt class="text-sm font-semibold text-hero-foreground/70">
              {ui.hero.location}
            </dt>
            <dd class="mt-2 font-semibold text-hero-foreground">
              {hero.locationValue}
            </dd>
          </div>
          <div class="rounded-card bg-hero-foreground/10 p-4">
            <dt class="text-sm font-semibold text-hero-foreground/70">
              {ui.nav.contact}
            </dt>
            <dd class="mt-2 font-semibold text-hero-foreground">
              {site.email}
            </dd>
          </div>
        </dl>
      </Container>
    </section>
  </body>
</html>
