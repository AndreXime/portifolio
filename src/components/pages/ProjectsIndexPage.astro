---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import Header from "../sections/Header.astro";
import Footer from "../sections/Footer.astro";
import Container from "../ui/Container.astro";
import AccentBar from "../ui/AccentBar.astro";
import Reveal from "../ui/Reveal.astro";
import ProjectTile from "../ui/ProjectTile.astro";
import { getProjects } from "../../lib/content";
import { getProjectPagePath } from "../../lib/project-page";
import { getPageContext } from "../../lib/i18n/context";
import { homeHash } from "../../lib/i18n/paths";

const { locale, ui, site } = await getPageContext(Astro.currentLocale);
const projects = await getProjects(locale);

const homeHref = homeHash(locale, "inicio");

const projectsWithReveal = projects.map((project, revealIndex) => ({
  project,
  revealIndex,
}));
---

<Layout
  locale={locale}
  site={site}
  title={`${ui.projectsIndex.title} | ${site.authorName}`}
  description={ui.projectsIndex.seoDescription}
>
  <Header />
  <main class="bg-muted pt-28 pb-16">
    <Container>
      <a
        href={homeHref}
        class="inline-flex shrink-0 items-center gap-2 self-start text-sm font-semibold text-muted-foreground underline decoration-border decoration-1 underline-offset-4 transition-colors duration-200 hover:text-accent hover:decoration-accent focus-ring"
      >
        <Icon name="arrow-left" class="size-3.5 shrink-0" />
        {ui.projectsIndex.backHome}
      </a>

      <div class="mt-10 max-w-3xl">
        <AccentBar class="mb-6" />
        <h1
          class="font-display text-3xl font-extrabold leading-tight tracking-tight text-foreground sm:text-4xl md:text-5xl"
        >
          {ui.projectsIndex.title}
        </h1>
        <p class="mt-4 text-sm font-semibold text-muted-foreground">
          {ui.projects.subtitle}
        </p>
        <p class="mt-6 text-base leading-[1.7] text-foreground-variant">
          {ui.projectsIndex.subtitle}
        </p>
      </div>

      <ul
        class="mt-14 list-none grid grid-cols-1 gap-6 lg:mt-16 lg:grid-cols-2 lg:gap-8"
      >
        {
          projectsWithReveal.map(({ project, revealIndex }) => (
            <li class="min-h-0 h-full">
              <Reveal staggerMs={revealIndex * 60} class="h-full min-h-0">
                <ProjectTile
                  project={project}
                  href={getProjectPagePath(project.slug, locale, {
                    fromList: true,
                  })}
                  ctaLabel={ui.projects.viewDetails}
                  stackAria={ui.projects.stackAria}
                  imageAltTemplate={ui.projectPage.imageAlt}
                  eager={revealIndex < 2}
                />
              </Reveal>
            </li>
          ))
        }
      </ul>
    </Container>
  </main>
  <Footer />
  <script>
    import { initReveal } from "../../scripts/reveal-observer";
    initReveal();
  </script>
</Layout>
